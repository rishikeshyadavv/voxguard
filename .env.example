# ==============================================================================
# VoxGuard Environment Configuration
# ==============================================================================

# Model Engine Selection ("stub" for mock/deterministic testing, "hf" for HuggingFace)
MODEL_BACKEND=stub

# HuggingFace Pretrained Anti-Spoofing Checkpoint (Active when MODEL_BACKEND=hf)
HF_MODEL_NAME=MattyB95/AST-VOXCELEB-SPOOFING-HOTFIX
HF_DEVICE=cpu

# Audio Pipeline Ingest Parameters
SAMPLE_RATE=16000
WINDOW_DURATION_SECONDS=2.0
HOP_DURATION_SECONDS=0.5

# Decision Logic & State Machine Parameters
# Number of 2.0s windows used in rolling moving average
SMOOTH_N=6

# Probability thresholds for state transitions
T_SUSPICIOUS=0.50
T_ALERT=0.75
ALERT_CONSECUTIVE=3
CLEAR_THRESHOLD=0.40

# Security & Networking
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
